{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@pmndrs/klipp": ["../src/core/index.ts"],
      "@pmndrs/klipp/three": ["../src/three/index.ts"],
      "@pmndrs/klipp/three/camera-controls": ["../src/three/body/CameraControlsBodyThree.ts"],
      "@pmndrs/klipp/react": ["../src/react/index.ts"],
      "@pmndrs/klipp/react/camera-controls": ["../src/react/body/camera-controls.ts"],
      "@pmndrs/klipp/dom": ["../src/dom/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
