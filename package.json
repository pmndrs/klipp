{
  "name": "@pmndrs/klipp",
  "version": "0.18.0",
  "description": "A camera toolkit for the web: a complete virtual camera system for any renderer, with React Three Fiber and three.js built on top. Inspired by Unity Cinemachine.",
  "keywords": [
    "camera",
    "virtual-camera",
    "orbit-controls",
    "cinemachine",
    "three.js",
    "react-three-fiber",
    "r3f",
    "webgl"
  ],
  "license": "MIT",
  "author": "Łukasz Kwas (https://github.com/kvvasuu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/klipp.git"
  },
  "homepage": "https://github.com/pmndrs/klipp#readme",
  "bugs": {
    "url": "https://github.com/pmndrs/klipp/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "pnpm run clean",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/add-js-extensions-dts.mjs && node scripts/build-docs.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.node.json && tsc -p test && tsc -p benches",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "bench": "pnpm --filter benches exec labs",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.7.0",
    "react": ">=19.2.0",
    "three": ">=0.156.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.2",
    "@react-three/test-renderer": "^9.1.1",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "math": "0.0.0-canary-20261026-7c55d752"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,yml,yaml,md,css,html}": "prettier --write"
  }
}
